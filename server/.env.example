# BorrowBox server settings. Copy this file to ".env" for local runs.
# Placeholders only: never put a real password or connection string here,
# and never commit your .env file.

# PostgreSQL connection string (Prisma). On Cloud Run it comes from
# Secret Manager (secret borrowbox-database-url). SECRET in the cloud.
DATABASE_URL="postgresql://borrowbox:borrowbox@localhost:5432/borrowbox?schema=public"

# Port the API listens on. Cloud Run sets it (3000 in this project).
PORT=3000

# Runtime mode. Cloud Run sets "production" (secure cookies, no default passwords).
# NODE_ENV=development

# Allowed browser origins for CORS, comma-separated. Only needed when the UI is
# served from another origin (local Vite dev server). Default: http://localhost:5173
# CLIENT_ORIGIN=http://localhost:5173

# Password of the first custodian (custodian@borrowbox.example), used only by
# the seed when the account does not exist yet. Required when NODE_ENV=production.
# On Cloud Run it comes from Secret Manager (borrowbox-admin-password). SECRET.
# ADMIN_PASSWORD=change-me

# Demo borrowers/custodian and sample items for UAT. Default: true locally,
# false in production.
# SEED_DEMO_DATA=false

# Password for the demo accounts. Required when SEED_DEMO_DATA=true in
# production (Secret Manager: borrowbox-demo-password). SECRET.
# DEMO_USER_PASSWORD=change-me
