# Settings for `docker compose up` (local only). Copy to ".env" and replace
# every change-me value with your own. Never commit .env.

POSTGRES_USER=borrowbox
POSTGRES_DB=borrowbox
POSTGRES_PASSWORD=change-me

# First custodian (custodian@borrowbox.example). At least 8 characters.
ADMIN_PASSWORD=change-me

# Demo accounts and sample items for testing (borrower1/2, custodian2).
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=change-me

# Host port for http://localhost:<port> (change it if 3000 is already in use).
APP_PORT=3000
